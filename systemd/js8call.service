[Unit]
Description=JS8Call headless environment for KD9NWA
After=network-online.target rigctld.service pipewire.service
Wants=rigctld.service

[Service]
Type=simple
ExecStart=%h/radio/agent/bin/js8call-headless
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group

# Deliberately not enabled at boot: JS8Call is started on demand because it
# shares CAT/audio resources with FT8, CW, and station scan operations.
[Install]
WantedBy=default.target
